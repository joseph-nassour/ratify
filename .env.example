# Ratify — every variable. None filled in. Copy to .env and fill locally.
#
# DRY_RUN=true is the committed default and should stay that way. The Foxit free
# Developer plan is 500 shared credits per YEAR for the whole project; dry run spends
# none of them and exercises the entire pipeline.
DRY_RUN=true

# --- Foxit ------------------------------------------------------------------------
# VERIFIED against the live developer portal and the live API, 2026-08-30: Foxit has
# unified their APIs. There is ONE credential pair, on ONE host, using plain
# client_id / client_secret headers. Foxit's older integration guide describes eSign as
# a separate host behind OAuth2 with a second credential set. It is not, and this
# project's hackathon-spec.md 1.2 is wrong about it too.
#
#   Document Generation : https://na1.fusion.foxit.com/document-generation/api/...
#   eSign               : https://na1.fusion.foxit.com/esign/api/v1/...
#
# SECURITY NOTE, and it is the reason app/supervisor.py looks the way it does: because
# the pair is unified, this credential can release a signature envelope. There is no
# document-only Foxit key. It therefore lives ONLY in the parent web process; the agent
# subprocess is spawned with an environment that contains no FOXIT_ variable at all,
# and refuses to start if one somehow reaches it. See DESIGN.md 5.2.
#
# The same three names are used locally, in Render's environment, and as the CI
# repository secrets in .github/workflows/ci.yml.
FOXIT_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# The deployed public instance deliberately sets NONE of the three, so that a stranger
# cannot spend the 500-credit annual allowance or create envelopes in the account.

# --- planner (optional; without it the deterministic planner is used) ------------
GEMINI_API_KEY=
GROQ_API_KEY=
RATIFY_PLANNER=deterministic

# --- deployment -------------------------------------------------------------------
PUBLIC_BASE_URL=
PRACTICE_NAME=Marlowe & Co Chartered Accountants
# PORT is injected by Render. Do not hard-code it.
