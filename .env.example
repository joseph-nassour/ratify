# Ratify — every variable. None filled in. Copy to .env and fill locally.
#
# DRY_RUN=true is the committed default and should stay that way. The Foxit free
# Developer plan is 500 shared credits per YEAR for the whole project; dry run spends
# none of them and exercises the entire pipeline.
DRY_RUN=true

# --- Foxit ------------------------------------------------------------------------
# CORRECTION, 2026-08-30, verified against the live developer portal: Foxit has
# unified their APIs. There is ONE credential pair, on ONE host, using plain
# client_id / client_secret headers. Foxit's own integration guide still describes
# eSign as a separate host behind OAuth2 with a second credential set. It is not.
#
#   Document Generation : https://na1.fusion.foxit.com/document-generation/api/generate
#   eSign               : https://na1.fusion.foxit.com/esign/api/v1/...
#
# The clients below still carry the older two-pair variable names; they are being
# corrected to the unified shape. Until then, set the same pair in both places.
FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLOUD_API_CLIENT_ID=
FOXIT_CLOUD_API_CLIENT_SECRET=

FOXIT_ESIGN_HOST=https://na1.fusion.foxit.com
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=

# CI uses these three names as repository secrets (see .github/workflows/ci.yml):
#   FOXIT_CLIENT_ID  FOXIT_CLIENT_SECRET  FOXIT_API_HOST

# --- planner (optional; without it the deterministic planner is used) ------------
GEMINI_API_KEY=
GROQ_API_KEY=
RATIFY_PLANNER=deterministic

# --- deployment -------------------------------------------------------------------
PUBLIC_BASE_URL=
PRACTICE_NAME=Marlowe & Co Chartered Accountants
# PORT is injected by Render. Do not hard-code it.
